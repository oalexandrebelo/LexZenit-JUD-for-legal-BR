  "edges": [
    {
      "type": "issued_by",
      "from": "NormativeInstrument",
      "to": "Authority",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "has_provision",
      "from": "NormativeInstrument",
      "to": "ProvisionVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "amends",
      "from": "ProvisionVersion",
      "to": "ProvisionVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "revokes",
      "from": "ProvisionVersion",
      "to": "ProvisionVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "interprets",
      "from": "LegalHolding",
      "to": "ProvisionVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "has_holding",
      "from": "JudicialDecision",
      "to": "LegalHolding",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "distinguishes",
      "from": "LegalHolding",
      "to": "LegalHolding",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "overrules",
      "from": "LegalHolding",
      "to": "LegalHolding",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "incorporates_standard",
      "from": "ProvisionVersion",
      "to": "TechnicalStandard",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "governed_by",
      "from": "Procedure",
      "to": "LegalRegime",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "in_jurisdiction",
      "from": "Authority",
      "to": "Jurisdiction",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "part_of",
      "from": "TextSegment",
      "to": "DocumentVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "evidences",
      "from": "TextSegment",
      "to": "Assertion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "reviews",
      "from": "Review",
      "to": "Assertion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "imposes",
      "from": "ProvisionVersion",
      "to": "Obligation",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "has_event",
      "from": "Procedure",
      "to": "ProceduralEvent",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "derives_deadline",
      "from": "ProceduralEvent",
      "to": "DeadlineAssessment",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "contains_item",
      "from": "Procedure",
      "to": "ProcurementItem",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "instantiates",
      "from": "InstrumentInstance",
      "to": "DeviceModel",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "uses_calculation",
      "from": "DeliverableVersion",
      "to": "Calculation",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    },
    {
      "type": "approved_version",
      "from": "Approval",
      "to": "DeliverableVersion",
      "requires_evidence": true,
      "requires_review_before_legal_retrieval": true
    }
  ],
  "assertion_states": [
    "proposed",
    "reviewed",
    "rejected",
    "superseded"
  ],
  "legal_requirement_states": [
    "satisfeito_no_escopo",
    "nao_conformidade_evidenciada",
    "inconclusivo",
    "nao_aplicavel_justificado",
    "erro"
  ],
  "jurisdiction_levels": [
    "country",
    "federal",
    "state",
    "federal_district",
    "municipality",
    "supranational"
  ],
  "invariants": [
    "Private graph identities and foreign keys include tenant and matter.",
    "An edge is an assertion, never automatic legal truth.",
    "Valid time, observed time and recorded time are separate.",
    "Unknown legal validity is not an unbounded approved interval.",
    "A judicial holding is not interchangeable with a case number or ementa.",
    "Technical standards require edition, rights and an applicable incorporation analysis.",
    "People identifiers are matter-scoped and pseudonymous in retrieval views.",
    "External action approval binds exact deliverable hash, operation and authenticated reviewer.",
    "Projection checkpoints expose eventual consistency and do not replace the transaction log.",
    "The current SQLite runtime implements only a subset of this ontology."
  ]
}
